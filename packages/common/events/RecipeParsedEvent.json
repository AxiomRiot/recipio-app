{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "event_type": {
      "type": "string",
      "const": "recipe-parsed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "site_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "cuisine": {
          "type": "string"
        },
        "image_url": {
          "type": "string"
        },
        "servings": {
          "type": "string"
        },
        "nutrients": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "prep_time_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cook_time_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ratings": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "ratings_count": {
          "type": "number"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "quantity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "url",
        "site_name",
        "description",
        "category",
        "cuisine",
        "image_url",
        "servings",
        "nutrients",
        "prep_time_min",
        "cook_time_min",
        "ratings",
        "ratings_count",
        "steps",
        "ingredients"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "header",
    "event_type",
    "payload"
  ],
  "additionalProperties": false
}