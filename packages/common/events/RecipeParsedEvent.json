{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "event_type": {
      "type": "string",
      "const": "recipe-parsed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "servings": {
          "type": "string"
        },
        "duration": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hours": {
              "type": "integer",
              "minimum": -9007199254740991,
              "exclusiveMaximum": 24
            },
            "minutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 60
            }
          },
          "required": [
            "days",
            "hours",
            "minutes"
          ],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "quantity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "url",
        "description",
        "servings",
        "duration",
        "steps",
        "ingredients"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "header",
    "event_type",
    "payload"
  ],
  "additionalProperties": false
}