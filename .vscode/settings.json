{
  // Disable the default formatter, use eslint instead
  "prettier.enable": true,
  "editor.formatOnSave": false,

  // Use pnpm and auto-detect working directories for monorepos
  "eslint.packageManager": "pnpm",
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "json5",
    "jsonc",
    "yaml",
    "toml",
    "xml",
    "gql",
    "graphql",
    "astro",
    "svelte",
    "css",
    "less",
    "scss",
    "pcss",
    "postcss"
  ]
}
